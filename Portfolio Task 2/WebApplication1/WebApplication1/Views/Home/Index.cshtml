@model WebApplication1.Models.DeploymentInfoViewModel
@{
    ViewData["Title"] = "Deployment Info";
}


<div class="text-center">
    <h1 class="display-6">Deployment Info:</h1>
    <ul class="list-unstyled">
        <li><b>Application:</b> @Model.ApplicationName</li>
        <li><b>Runtime:</b> @Model.Runtime</li>
        <li><b>Deployment Target:</b> @Model.DeploymentTarget</li>
        <li><b>Status:</b> @Model.Status</li>
    </ul>
</div>
